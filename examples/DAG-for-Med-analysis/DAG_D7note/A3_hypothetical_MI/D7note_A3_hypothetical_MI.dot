  "T" [label="E[Y(1,s=1)] − E[Y(0,s=1)]\n(imputed for the dead)" shape=diamond style="filled" fillcolor="#fde2c4" fontcolor="#222222" color="#fd7e14" fontsize=11 width=2.708 height=1.146 pos="920,-380!"]

  "X" -> "S" [label="imputation model
